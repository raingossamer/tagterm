{
  "name": "tagterm",
  "version": "0.3.10",
  "private": true,
  "description": "TagTerm：多标签终端会话管理 —— 一个会话 = 一个固定工作目录的终端",
  "main": "./out/main/index.js",
  "author": "raingossamer",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build && electron-builder --publish never",
    "build:dir": "electron-vite build && electron-builder --dir --publish never",
    "screenshots": "electron-vite build && electron scripts/screenshots/main.cjs",
    "typecheck": "vue-tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.node.json",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check src tests scripts"
  },
  "dependencies": {
    "@vscode/windows-process-tree": "0.8.0",
    "electron-updater": "6.8.9",
    "node-pty": "1.1.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.13.3",
    "@vitejs/plugin-vue": "6.0.8",
    "@vue/test-utils": "2.5.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-search": "0.16.0",
    "@xterm/addon-unicode11": "0.9.0",
    "@xterm/addon-webgl": "0.19.0",
    "@xterm/xterm": "6.0.0",
    "electron": "44.3.0",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-vue": "10.11.0",
    "globals": "17.12.0",
    "happy-dom": "20.14.0",
    "pinia": "4.0.3",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.1",
    "vite": "7.3.6",
    "vitest": "4.1.11",
    "vue": "3.5.42",
    "vue-eslint-parser": "10.4.1",
    "vue-tsc": "3.3.11"
  },
  "packageManager": "pnpm@11.17.0"
}
